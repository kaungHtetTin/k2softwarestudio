# Copy this file to `.env` and adjust values. Never commit `.env`.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/k2/public

# MySQL (create database first, then import database/schema.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=k2_portfolio
DB_USERNAME=root
DB_PASSWORD=

# Mail — contact form (Phase 3); SMTP recommended in production
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=K2 Portfolio
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Contact form (Phase 3) — where to send notifications; must be a valid email
CONTACT_MAIL_TO=you@example.com

# Max contact submissions per IP per window (sliding)
CONTACT_THROTTLE_MAX=5
CONTACT_THROTTLE_WINDOW=3600

# Login throttle (Phase 1) — failed attempts per IP + identity in sliding window (seconds)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW=900

# Blog (Phase 5)
BLOG_PER_PAGE=10
# Max featured image upload size in bytes (default ~3 MB)
UPLOAD_MAX_IMAGE_BYTES=3145728
